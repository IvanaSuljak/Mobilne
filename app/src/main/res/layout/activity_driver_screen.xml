<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:titleTextColor="@android:color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dobrodošli!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:background="@android:color/holo_blue_light"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/ulogaTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Uloga: VOZAC"
            android:textSize="18sp"
            android:textAlignment="center"
            android:background="@android:color/holo_orange_light"
            android:padding="12dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/syncInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sinhronizacija: Na svakih 1 min"
            android:textSize="14sp"
            android:textAlignment="center"
            android:padding="8dp"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚗 Moje vožnje"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="@android:color/background_light"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ovde će biti prikazane vaše vožnje..."
            android:textSize="14sp"
            android:padding="12dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Podešavanja sinhronizacije"
            android:layout_marginBottom="12dp"
            android:maxWidth="400dp" />

        <Button
            android:id="@+id/contactsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pregledaj kontakte"
            android:layout_marginBottom="12dp"
            android:maxWidth="400dp" />

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Odjavi se"
            android:background="@android:color/holo_red_dark"
            android:textColor="@android:color/white"
            android:maxWidth="400dp" />

    </LinearLayout>

</LinearLayout>
